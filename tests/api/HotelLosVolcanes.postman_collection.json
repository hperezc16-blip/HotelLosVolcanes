{
  "info": {
    "name": "Hotel Los Volcanes - Pruebas de API (Fase 2)",
    "description": "Pruebas de API con aserciones de código de respuesta, esquema y contenido. La carpeta 'Flujo de reservación' encadena un flujo completo de negocio: registro, login, búsqueda, reservación, pago y gestión por el administrador. Ejecutar en orden con Newman o el Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Flujo de reservación",
      "item": [
        {
          "name": "01 Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responde en menos de 2 segundos\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "pm.test(\"Contenido: status ok\", () => pm.expect(pm.response.json()).to.eql({ status: \"ok\" }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "02 Registrar cliente nuevo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"clienteEmail\", `qa.${Date.now()}@hotel-test.com`);",
                  "pm.collectionVariables.set(\"clientePassword\", \"ClienteQA123!\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Esquema de respuesta de autenticación\", () => {",
                  "  pm.response.to.have.jsonSchema({",
                  "    type: \"object\", required: [\"token\", \"user\"],",
                  "    properties: {",
                  "      token: { type: \"string\" },",
                  "      user: { type: \"object\", required: [\"id\", \"nombre\", \"email\", \"rol\", \"activo\"],",
                  "        properties: { id: { type: \"string\" }, email: { type: \"string\" }, rol: { enum: [\"cliente\", \"admin\"] }, activo: { type: \"boolean\" } } }",
                  "    }",
                  "  });",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Se registra siempre con rol cliente\", () => pm.expect(body.user.rol).to.eql(\"cliente\"));",
                  "pm.test(\"No expone el hash de la contraseña\", () => pm.expect(body.user).to.not.have.property(\"passwordHash\"));",
                  "pm.collectionVariables.set(\"clienteId\", body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente QA\",\n  \"email\": \"{{clienteEmail}}\",\n  \"password\": \"{{clientePassword}}\",\n  \"telefono\": \"50255550000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "03 Login del cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Devuelve un JWT válido\", () => pm.expect(body.token.split(\".\")).to.have.lengthOf(3));",
                  "pm.test(\"El JWT expira en 24 horas (RNF-03)\", () => {",
                  "  const payload = JSON.parse(atob(body.token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\")));",
                  "  pm.expect(payload.exp - payload.iat).to.eql(86400);",
                  "});",
                  "pm.test(\"El usuario es el recién registrado\", () => pm.expect(body.user.id).to.eql(pm.collectionVariables.get(\"clienteId\")));",
                  "pm.collectionVariables.set(\"clienteToken\", body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clienteEmail}}\",\n  \"password\": \"{{clientePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },

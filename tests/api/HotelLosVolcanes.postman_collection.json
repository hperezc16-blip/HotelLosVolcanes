        {
          "name": "08 Disponibilidad por fechas",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fechas futuras aleatorias para que la colección se pueda correr muchas veces sin choques.",
                  "const d = n => { const x = new Date(); x.setDate(x.getDate() + n); return x.toISOString().slice(0, 10); };",
                  "const off = 400 + Math.floor(Math.random() * 3000);",
                  "pm.collectionVariables.set(\"fechaEntrada\", d(off));",
                  "pm.collectionVariables.set(\"fechaSalida\", d(off + 2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"La habitación elegida está disponible\", () =>",
                  "  pm.expect(pm.response.json().map(r => r.id)).to.include(pm.collectionVariables.get(\"roomId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rooms?fechaEntrada={{fechaEntrada}}&fechaSalida={{fechaSalida}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rooms"
              ],
              "query": [
                {
                  "key": "fechaEntrada",
                  "value": "{{fechaEntrada}}"
                },
                {
                  "key": "fechaSalida",
                  "value": "{{fechaSalida}}"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "09 Crear reservación",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Esquema de la reservación\", () => pm.response.to.have.jsonSchema({",
                  "  type: \"object\", required: [\"id\", \"clienteId\", \"habitacionId\", \"fechaEntrada\", \"fechaSalida\", \"precioTotal\", \"estado\", \"estadoPago\", \"room\", \"cliente\"],",
                  "  properties: { estado: { enum: [\"pendiente\", \"confirmada\", \"cancelada\", \"completada\"] }, estadoPago: { enum: [\"pendiente\", \"anticipo\", \"pagado\"] } }",
                  "}));",
                  "pm.test(\"Queda confirmada y con pago pendiente\", () => { pm.expect(r.estado).to.eql(\"confirmada\"); pm.expect(r.estadoPago).to.eql(\"pendiente\"); });",
                  "pm.test(\"Precio total = 2 noches x precio por noche\", () =>",
                  "  pm.expect(Number(r.precioTotal)).to.eql(Number(pm.collectionVariables.get(\"roomPrecio\")) * 2));",
                  "pm.test(\"Pertenece al cliente autenticado\", () => pm.expect(r.clienteId).to.eql(pm.collectionVariables.get(\"clienteId\")));",
                  "pm.collectionVariables.set(\"reservaId\", r.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }

            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Todas las habitaciones son suite\", () => pm.expect(pm.response.json().every(r => r.tipo === \"suite\")).to.be.true);"
                ]

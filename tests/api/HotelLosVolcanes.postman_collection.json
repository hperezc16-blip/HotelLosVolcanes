        {
          "name": "16 Dashboard del administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Esquema de estadísticas\", () => pm.response.to.have.jsonSchema({",
                  "  type: \"object\",",

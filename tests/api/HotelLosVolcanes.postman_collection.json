            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clienteToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "05 Listar habitaciones",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "const rooms = pm.response.json();",
                  "pm.test(\"Esquema: lista de habitaciones\", () => pm.response.to.have.jsonSchema({",
                  "  type: \"array\", minItems: 1,",
                  "  items: { type: \"object\", required: [\"id\", \"nombre\", \"tipo\", \"precioNoche\", \"capacidad\", \"activo\"],",
                  "    properties: { tipo: { enum: [\"sencilla\", \"doble\", \"suite\", \"cabana\"] }, capacidad: { type: \"integer\" }, activo: { const: true } } }",
                  "}));",
                  "pm.test(\"Solo muestra habitaciones activas\", () => pm.expect(rooms.every(r => r.activo === true)).to.be.true);",
                  "const suite = rooms.find(r => r.tipo === \"suite\") || rooms[0];",
                  "pm.collectionVariables.set(\"roomId\", suite.id);",
                  "pm.collectionVariables.set(\"roomPrecio\", suite.precioNoche);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rooms"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },

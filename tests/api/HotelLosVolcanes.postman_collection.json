          "name": "04 Perfil del cliente (me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Esquema del usuario público\", () => pm.response.to.have.jsonSchema({",
                  "  type: \"object\", required: [\"id\", \"nombre\", \"email\", \"rol\"], not: { required: [\"passwordHash\"] }",
                  "}));",
                  "pm.test(\"Contenido: correo del cliente\", () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get(\"clienteEmail\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"

{
  "buildCommand": "pnpm --filter @workspace/hotel-app build",
  "outputDirectory": "artifacts/hotel-app/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sistema-reservaciones-hotel-production.up.railway.app/api/:path*"
    }
  ]
}
